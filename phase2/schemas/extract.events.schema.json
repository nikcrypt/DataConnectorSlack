{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataconnector.local/schemas/extract.events.json",
  "title": "extract.events",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "event", "connector_key", "at"],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "event": {
      "type": "string",
      "enum": ["started", "progress", "completed", "failed"]
    },
    "connector_key": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "string",
      "description": "Required for progress; optional for started/completed/failed."
    },
    "records_written": {
      "type": "integer",
      "minimum": 0
    },
    "worker_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "error": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object", "uri"],
        "properties": {
          "object": { "type": "string" },
          "uri": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "record_count": { "type": "integer", "minimum": 0 },
          "content_hash": { "type": "string" }
        }
      }
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
