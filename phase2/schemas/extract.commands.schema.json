{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataconnector.local/schemas/extract.commands.json",
  "title": "extract.commands",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "connector_key", "requested_at"],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Matches extraction_requests.id; workers load full job from Postgres."
    },
    "connector_key": {
      "type": "string",
      "minLength": 1,
      "description": "Partition key; worker filters on CONNECTOR_KEY."
    },
    "objects": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Optional hint; authoritative list is in Postgres."
    },
    "mode": {
      "type": "string",
      "enum": ["full", "incremental"],
      "default": "full"
    },
    "tenant_id": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
