{
  "name": "data-connector-app-poc",
  "version": "1.0.0",
  "description": "Data connector POC — Slack, PostgreSQL, MySQL, Oracle, SharePoint, Salesforce, Jira, Google Drive, Box, Confluence, and Windows folder extraction with Node.js",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "auth": "node src/auth-server.js",
    "auth:status": "node src/cli.js auth-status",
    "auth:googledrive": "node src/connectors/googledrive/loginCli.js",
    "test:connection": "node src/cli.js test",
    "test:slack": "node src/cli.js test --connector slack",
    "test:postgres": "node src/cli.js test --connector postgres",
    "test:mysql": "node src/cli.js test --connector mysql",
    "test:oracle": "node src/cli.js test --connector oracle",
    "test:sharepoint": "node src/cli.js test --connector sharepoint",
    "test:salesforce": "node src/cli.js test --connector salesforce",
    "test:jira": "node src/cli.js test --connector jira",
    "test:googledrive": "node src/cli.js test --connector googledrive",
    "test:box": "node src/cli.js test --connector box",
    "test:confluence": "node src/cli.js test --connector confluence",
    "extract": "node src/cli.js extract",
    "extract:slack": "node src/cli.js extract --connector slack",
    "extract:slack:mongo": "node src/cli.js extract-mongo --connector slack",
    "extract:slack:mongo:incremental": "node src/cli.js extract-mongo --connector slack --mode incremental --objects messages",
    "extract:postgres": "node src/cli.js extract --connector postgres",
    "extract:postgres:mongo": "node src/cli.js extract-mongo --connector postgres",
    "extract:mysql": "node src/cli.js extract --connector mysql",
    "extract:mysql:mongo": "node src/cli.js extract-mongo --connector mysql",
    "extract:oracle": "node src/cli.js extract --connector oracle",
    "extract:oracle:mongo": "node src/cli.js extract-mongo --connector oracle",
    "extract:sharepoint": "node src/cli.js extract --connector sharepoint",
    "extract:sharepoint:mongo": "node src/cli.js extract-mongo --connector sharepoint",
    "extract:salesforce": "node src/cli.js extract --connector salesforce",
    "extract:salesforce:mongo": "node src/cli.js extract-mongo --connector salesforce",
    "extract:jira": "node src/cli.js extract --connector jira",
    "extract:jira:mongo": "node src/cli.js extract-mongo --connector jira",
    "extract:googledrive": "node src/cli.js extract --connector googledrive",
    "extract:googledrive:mongo": "node src/cli.js extract-mongo --connector googledrive",
    "extract:box": "node src/cli.js extract --connector box",
    "extract:box:mongo": "node src/cli.js extract-mongo --connector box",
    "extract:confluence": "node src/cli.js extract --connector confluence",
    "extract:confluence:mongo": "node src/cli.js extract-mongo --connector confluence",
    "test:windows": "node src/cli.js test --connector windows",
    "extract:windows": "node src/cli.js extract --connector windows",
    "extract:windows:mongo": "node src/cli.js extract-mongo --connector windows",
    "extract:users": "node src/cli.js extract --objects users",
    "extract:channels": "node src/cli.js extract --objects channels",
    "extract:messages": "node src/cli.js extract --objects messages",
    "bench:slack": "node src/bench/runSlackBench.js",
    "bench:slack:mongo": "node src/bench/runSlackMongoDemo.js",
    "env:encrypt": "node src/secrets/envFileCrypto.js encrypt",
    "env:decrypt": "node src/secrets/envFileCrypto.js decrypt"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@marsaud/smb2": "^0.16.0",
    "dotenv": "^16.4.7",
    "mongodb": "^6.21.0",
    "mysql2": "^3.24.5",
    "oracledb": "^6.10.0",
    "pg": "^8.13.1"
  }
}
