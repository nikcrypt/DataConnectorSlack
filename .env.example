# Slack app credentials (api.slack.com → Basic Information → App Credentials)
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Must match Redirect URL configured in Slack OAuth & Permissions
SLACK_REDIRECT_URI=http://localhost:3000/slack/oauth/callback
PORT=3000

# Comma-separated bot scopes for install
SLACK_BOT_SCOPES=channels:read,channels:history,groups:read,groups:history,users:read,usergroups:read,files:read,team:read

# Set automatically by OAuth, or paste Bot User OAuth Token (xoxb-...)
# SLACK_BOT_TOKEN=

# Optional User OAuth Token (xoxp-...) — fallback for methods the bot cannot access
# SLACK_USER_TOKEN=

SLACK_HISTORY_DAYS=30
# SLACK_CHANNEL_IDS=

# MongoDB — used by npm run extract:slack:mongo and npm run extract:jira:mongo
# MONGO_URL=mongodb+srv://user:password@cluster.example.mongodb.net/data_connector_poc_micro_service

# --- PostgreSQL (metadata extract: schemas, tables, views, columns) ---
# Option A: connection URL
# POSTGRES_URL=postgresql://connector_reader:password@localhost:5432/appdb?sslmode=require

# Option B: separate fields
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=appdb
POSTGRES_USER=connector_reader
POSTGRES_PASSWORD=your-password
POSTGRES_SSL=false

# Optional: only these schemas (comma-separated). Empty = all non-system schemas.
# POSTGRES_SCHEMAS=public

# --- MySQL (metadata extract: schemas, tables, views, columns) ---
# MYSQL_URL=mysql://connector_reader:password@localhost:3306/appdb
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=appdb
MYSQL_USER=connector_reader
MYSQL_PASSWORD=your-password
MYSQL_SSL=false
# Optional: only these schemas. Empty = all except mysql, information_schema, performance_schema, sys
# MYSQL_SCHEMAS=appdb

# --- Oracle (metadata extract: schemas, tables, views, columns) ---
# Thin mode via node-oracledb — Instant Client is not required.
ORACLE_USER=app_reader
ORACLE_PASSWORD=your-password
# Easy Connect: host:port/service_name
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
# Or build it from parts (used when ORACLE_CONNECT_STRING is empty):
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE_NAME=XEPDB1
# ORACLE_SID=ORCL
# Optional: only these owners (comma-separated). Empty = all non-system schemas.
# ORACLE_SCHEMAS=HR,APP

# --- SharePoint Online (Microsoft Graph, app-only / client credentials) ---
# Register an app in Microsoft Entra ID and grant Graph application permission Sites.Read.All (admin consent)
# or Sites.Selected + site grants.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_HOSTNAME=contoso.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/engineering

# --- Salesforce (Connected App OAuth) ---
# Setup: Salesforce Setup → App Manager → New Connected App
# Enable OAuth, add refresh_token/api scopes (and enable client credentials if using that flow).
SALESFORCE_LOGIN_URL=https://login.salesforce.com
# For sandboxes: https://test.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Password grant (common for POC). Leave blank to try client_credentials instead.
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
# Comma-separated sObjects for fields + records extract
SALESFORCE_OBJECTS=Account,Contact,Opportunity
SALESFORCE_RECORD_LIMIT=10000
# SALESFORCE_API_VERSION=v59.0

# --- Jira Cloud ---
# Create API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
# Optional filter / limits
# JIRA_JQL=updated >= -365d ORDER BY updated DESC
# JIRA_MAX_ISSUES=500

# --- Google Drive ---
# Option A: service account JSON (share Drive folders with the SA email)
GOOGLE_SERVICE_ACCOUNT_FILE=./certs/google-sa.json
# Domain-wide delegation (Workspace): impersonate a user
# GOOGLE_IMPERSONATE_USER=user@company.com
# Option B: OAuth user refresh token
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Option C: short-lived bearer (POC only)
# GOOGLE_ACCESS_TOKEN=
# Optional limits / filters
# GOOGLE_DRIVE_MAX_FILES=2000
# GOOGLE_DRIVE_PERMISSION_FILE_LIMIT=50
# GOOGLE_DRIVE_INCLUDE_SHARED=true
# GOOGLE_DRIVE_QUERY=name contains 'report'
# GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.readonly

# --- Box ---
# Option A: developer token (short-lived POC) from https://developer.box.com/guides/authentication/tokens/developer-tokens/
BOX_ACCESS_TOKEN=
# Option B: Client Credentials Grant (server app)
# BOX_CLIENT_ID=
# BOX_CLIENT_SECRET=
# BOX_ENTERPRISE_ID=
# Or impersonate a user subject:
# BOX_USER_ID=
# Option C: OAuth refresh token
# BOX_CLIENT_ID=
# BOX_CLIENT_SECRET=
# BOX_REFRESH_TOKEN=
# Optional limits
# BOX_ROOT_FOLDER_ID=0
# BOX_MAX_DEPTH=5
# BOX_MAX_ITEMS=2000
# BOX_COLLAB_FOLDER_LIMIT=50

# --- Confluence Cloud ---
# Same Atlassian API token as Jira. If these are omitted, JIRA_* is reused.
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
CONFLUENCE_EMAIL=you@company.com
CONFLUENCE_API_TOKEN=
# Optional limits
# CONFLUENCE_MAX_PAGES=500
# CONFLUENCE_MAX_BLOGPOSTS=200
# CONFLUENCE_ATTACHMENT_PAGE_LIMIT=50
# CONFLUENCE_BODY_EXCERPT_CHARS=2000

# --- Windows folder (one share or mounted folder, not a whole drive) ---
# Remote share:
# WINDOWS_FOLDER_URL=smb://fileserver/team/reports
# WINDOWS_USERNAME=
# WINDOWS_PASSWORD=
# WINDOWS_DOMAIN=WORKGROUP
# Folder mounted on this machine or in Docker:
# WINDOWS_FOLDER_URL=file:///path/to/folder
# Optional limits
# WINDOWS_MAX_DEPTH=5
# WINDOWS_MAX_FILES=2000
# WINDOWS_MAX_DOWNLOAD_BYTES=5242880
# WINDOWS_DOWNLOAD=true
