# Slack app credentials (api.slack.com → Basic Information → App Credentials)
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Must match Redirect URL configured in Slack OAuth & Permissions
SLACK_REDIRECT_URI=http://localhost:3000/slack/oauth/callback
PORT=3000

# Comma-separated bot scopes for install
SLACK_BOT_SCOPES=channels:read,channels:history,groups:read,groups:history,users:read,usergroups:read,files:read,team:read

# Set automatically by OAuth, or paste Bot User OAuth Token (xoxb-...)
# SLACK_BOT_TOKEN=

# Optional User OAuth Token (xoxp-...) — fallback for methods the bot cannot access
# SLACK_USER_TOKEN=

SLACK_HISTORY_DAYS=30
# SLACK_CHANNEL_IDS=

# --- PostgreSQL (metadata extract: schemas, tables, views, columns) ---
# Option A: connection URL
# POSTGRES_URL=postgresql://connector_reader:password@localhost:5432/appdb?sslmode=require

# Option B: separate fields
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=appdb
POSTGRES_USER=connector_reader
POSTGRES_PASSWORD=your-password
POSTGRES_SSL=false

# Optional: only these schemas (comma-separated). Empty = all non-system schemas.
# POSTGRES_SCHEMAS=public

# --- SharePoint Online (Microsoft Graph, app-only / client credentials) ---
# Register an app in Microsoft Entra ID and grant Graph application permission Sites.Read.All (admin consent)
# or Sites.Selected + site grants.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_HOSTNAME=contoso.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/engineering
