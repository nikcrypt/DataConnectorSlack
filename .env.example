# Slack app credentials (api.slack.com → Basic Information → App Credentials)
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Must match Redirect URL configured in Slack OAuth & Permissions
SLACK_REDIRECT_URI=http://localhost:3000/slack/oauth/callback
PORT=3000

# Comma-separated bot scopes for install
SLACK_BOT_SCOPES=channels:read,channels:history,groups:read,groups:history,users:read,usergroups:read,files:read,team:read

# Set automatically by OAuth, or paste Bot User OAuth Token (xoxb-...)
# SLACK_BOT_TOKEN=

# Optional User OAuth Token (xoxp-...) — fallback for methods the bot cannot access
# SLACK_USER_TOKEN=

SLACK_HISTORY_DAYS=30
# SLACK_CHANNEL_IDS=
